# WhatSaaS — production environment (copy to .env on VPS)
# Database: Drizzle ORM (primary). Prisma stub exists for legacy only.

NODE_ENV=production
BASE_URL=https://app.your-domain.com
POSTGRES_URL=postgresql://whats_saas:STRONG_PASSWORD@localhost:5432/whats_saas
REDIS_URL=redis://localhost:6379

AUTH_SECRET=generate_64_char_hex
CRON_SECRET=generate_64_char_hex

# Evolution
EVOLUTION_API_URL=https://evolution.your-domain.com
EVOLUTION_PUBLIC_URL=https://evolution.your-domain.com
AUTHENTICATION_API_KEY=evolution_global_api_key
NEXT_PUBLIC_EVOLUTION_WEBHOOK_TOKEN=webhook_shared_secret
WEBHOOK_GLOBAL_URL=https://app.your-domain.com/api/webhook/evolution

# Meta Cloud (optional)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# OpenAI
OPENAI_API_KEY=sk-...
DEFAULT_AI_MODEL=gpt-4o-mini
AI_DEBOUNCE_MS=5000

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Pusher
PUSHER_APP_ID=
NEXT_PUBLIC_PUSHER_KEY=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_CLUSTER=ap2

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@your-domain.com
SUPPORT_EMAIL=support@your-domain.com

# PM2
PM2_INSTANCES=2

# Alerts (Telegram/Slack webhook URL)
HEALTH_ALERT_WEBHOOK_URL=

# Docker compose only
POSTGRES_PASSWORD=STRONG_PASSWORD
POSTGRES_DB=whats_saas
POSTGRES_USER=whats_saas
